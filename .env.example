# Публичный адрес сайта (для canonical, hreflang, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://nishman.uz

# DEV: показывать бейдж «DEMO» у придуманных записей (цены, адреса, отзывы, условия опта)
NEXT_PUBLIC_SHOW_DEMO=false

# Telegram-бот для заявок и заказов (@BotFather → токен; chat_id — чат/канал менеджера)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Click (https://docs.click.uz) — выдаются после подключения мерчанта
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# Payme (https://developer.help.paycom.uz) — ID кассы и ключ
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true

# Тайлы карты. Пусто — Esri World Dark Gray (без ключа, см. README → «Карта»).
# С ключом CARTO Dark Matter: полный URL шаблона, например https://.../dark_all/{z}/{x}/{y}.png?api_key=...
NEXT_PUBLIC_MAP_TILE_URL=
